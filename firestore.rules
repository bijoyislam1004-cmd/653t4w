rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function me(){return get(/databases/$(d)/documents/users/$(request.auth.uid)).data}
 function admin(){return request.auth!=null&&me().role=="admin"}
 match /{p=**}{allow read:if request.auth!=null}
 match /{c}/{id}{allow write:if admin()}
 match /auction/state{allow write:if admin()||(request.auth!=null&&me().role=="team"
  &&request.resource.data.bidder==me().teamId
  &&(resource.data.bidder==null||request.resource.data.bid>resource.data.bid)
  &&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["bid","bidder","history"]))}
}}
